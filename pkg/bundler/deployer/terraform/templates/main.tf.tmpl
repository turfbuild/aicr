# Generated by AICR {{ .Version }} — do not edit.
#
# One module call per release. depends_on carries the recipe's dependency
# graph exactly: a component waits for its declared dependencies and nothing
# else, so independent components apply concurrently.
{{- if .Serial }}
#
# Generated with --serial: the declared graph has been replaced by a single
# linear chain, so releases apply strictly one at a time.
{{- end }}
{{ range .Releases }}
# {{ .Title }}
module "{{ .Label }}" {
  source = "./modules/component"

{{ align "  " .Identity }}

{{ align "  " .Chart }}

  values_files = [
{{- range .ValuesFiles }}
    "${path.module}/{{ . }}",
{{- end }}
  ]

{{ if .Note }}  # {{ .Note }}
{{ end }}{{ align "  " .Behavior }}
{{- if .DependsOn }}

  depends_on = [
{{- range .DependsOn }}
    module.{{ . }},
{{- end }}
  ]
{{- end }}
}
{{ end -}}

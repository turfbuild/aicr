# Generated by AICR {{ .Version }} — do not edit.

output "criteria" {
  description = "The AICR criteria this bundle was resolved from."
  value       = {{ .Criteria | quote }}
}

output "releases" {
  description = "Release name -> namespace, for every release in the bundle."
  value = {
{{ align "    " .ReleaseMap }}
  }
}

output "namespaces" {
  description = "Distinct namespaces the bundle installs into."
  value       = distinct([{{ range $i, $r := .Releases }}{{ if $i }}, {{ end }}{{ $r.Namespace | quote }}{{ end }}])
}
